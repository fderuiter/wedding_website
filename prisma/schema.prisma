// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client" // Add recommended output path
}

datasource db {
  provider = "postgresql"
}

model AppConfig {
  id               String   @id @default("global")
  subdomain        String?  @unique
  partner1Name     String   @default("")
  partner2Name     String   @default("")
  brideName        String?  @default("")
  groomName        String?  @default("")
  weddingDate      DateTime @default(dbgenerated("NOW()"))
  baseUrl          String   @default("")
  venueName        String   @default("")
  venueAddress     String   @default("")
  venueCity        String   @default("")
  venueState       String   @default("")
  venueZip         String   @default("")
  latitude         Float    @default(0.0)
  longitude        Float    @default(0.0)
  storyText        String   @default("")
  venueDescription String   @default("")
  travelAdvice     String   @default("")
  heroTitle        String   @default("")
  heroSubtitle     String   @default("")
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  contactEmail     String   @default("")
  faviconUrl       String   @default("/assets/favicon.png")
  ogImageUrl       String   @default("/images/sunset-embrace.jpg")
  brandMonogram    String?
  brandLogoUrl     String?
  brandLogoAlt     String?
  heroImageUrl     String?
  heroImageAlt     String?
  brandWatermarkUrl String?
  brandWatermarkAlt String?
  badgeGraphicUrl  String?
  badgeGraphicAlt  String?
  seoKeywords      String   @default("{{partner1Name}} and {{partner2Name}}'s wedding, wedding website, {{venueName}} wedding, {{venueCity}} {{venueState}} wedding, {{partner1Name}} and {{partner2Name}} registry, wedding details, wedding ceremony, wedding reception")
  colorPrimary     String   @default("#B91C1C")
  colorSecondary   String   @default("#B45309")
  themePreset      String   @default("classic")
  themeTokens      Json     @default("{}")
  layoutContainerMaxWidth String @default("64rem")
  layoutGridGap           String @default("1.5rem")
  layoutCardPadding       String @default("2rem")
  layoutBorderRadius      String @default("1rem")
  features         Json     @default("[]")
  timezone         String   @default("America/Chicago")
  showCountdown    Boolean  @default(true)
  showAddToCalendar Boolean  @default(true)
  emailProvider    String   @default("smtp")
  smtpHost         String?  @default("")
  smtpPort         Int?     @default(587)
  smtpUser         String?  @default("")
  smtpPass         String?  @default("")
  smtpFrom         String?  @default("")
  smtpSecure       Boolean? @default(false)
  resendApiKey     String?  @default("")
  resendFrom       String?  @default("")
  sendgridApiKey   String?  @default("")
  sendgridFrom     String?  @default("")
  smsProvider      String?  @default("none")
  twilioAccountSid String?  @default("")
  twilioAuthToken  String?  @default("")
  twilioFromNumber String?  @default("")
  broadcastBatchSize Int    @default(50)
  broadcastBatchDelayMs Int @default(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Media {
  id           String   @id @default(uuid())
  url          String
  altText      String?
  isDecorative Boolean  @default(false)
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weddingPartyMembers WeddingPartyMember[]
  attractions         Attraction[]
  registryItems       RegistryItem[]
}

enum WeddingPartySide {
  BRIDE
  GROOM
  JOINT
}

model WeddingPartyMember {
  id        String            @id @default(uuid())
  name      String
  role      String
  bio       String
  side      WeddingPartySide?
  photoId   String?
  photo     Media?            @relation(fields: [photoId], references: [id])
  link      String?
  order     Int               @default(0)
  isSample  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Attraction {
  id          String   @id @default(uuid())
  name        String
  description String
  imageId     String?
  image       Media?   @relation(fields: [imageId], references: [id])
  category    String
  website     String
  directions  String
  latitude    Float
  longitude   Float
  isVisible   Boolean  @default(true)
  promoCode   String?
  bookingUrl  String?
  roomRate    String?
  cutoffDate  String?
  shuttleInfo String?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RegistryItem {
  id                String        @id @default(uuid())
  itemType          String        @default("PHYSICAL")
  paymentHandleType String?
  paymentHandle     String?
  name              String
  description       String
  category          String
  price             Float
  imageId           String
  image             Media         @relation(fields: [imageId], references: [id])
  vendorUrl         String?
  quantity          Int           @default(1)
  isGroupGift       Boolean       @default(false)
  isMostWanted      Boolean       @default(false)
  displayOrder      Int           @default(0)
  purchased         Boolean       @default(false)
  purchaserName     String?
  amountContributed Float         @default(0)
  isSample          Boolean       @default(false)
  contributors      Contributor[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Contributor {
  id             String        @id @default(uuid())
  name           String
  email          String?
  isPlusOne      Boolean       @default(false)
  amount         Float         @default(0)
  coverFee       Boolean       @default(false)
  feeAmount      Float         @default(0)
  message        String?
  date           DateTime      @default(now())
  thankYouStatus String        @default("Unsent")
  thankYouSentAt DateTime?
  thankYouNote   String?
  registryItem   RegistryItem? @relation(fields: [registryItemId], references: [id], onDelete: Cascade)
  registryItemId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invitationCodeId String?
  invitationCode   InvitationCode? @relation(fields: [invitationCodeId], references: [id])
}

model InvitationCode {
  id                 String        @id @default(uuid())
  code               String        @unique
  guestName          String
  email              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  zipCode            String?
  country            String?
  dietaryNotes       String?
  plusOneAllocations Int?          @default(0)
  plusOneFirstName   String?
  plusOneLastName    String?
  householdName      String?
  partyGroup         String?
  partyTags          String[]      @default([])
  extraFields        Json?
  used               Boolean       @default(false)
  usedAt             DateTime?
  tableId            String?
  table              SeatingTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  seatNumber         Int?
  isSample           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  contributors Contributor[]
  subEventAccesses SubEventAccess[]
  subEventRsvps    SubEventRsvp[]
  broadcastRecipients BroadcastRecipient[]

  @@index([partyTags], type: Gin)
}

model SeatingTable {
  id              String           @id @default(uuid())
  name            String
  shape           String           @default("round")
  capacity        Int              @default(8)
  x               Float            @default(0.0)
  y               Float            @default(0.0)
  width           Float            @default(120.0)
  height          Float            @default(120.0)
  rotation        Float            @default(0.0)
  isSample        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invitationCodes InvitationCode[]
}

model ContentNode {
  id        String   @id @default(uuid())
  type      String // e.g., "FAQ", "Logistics", "Photo"
  tags      String[] // e.g., ["Homepage", "FAQ"]
  data      Json // Flexible key-value pairs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SnapshotVersion {
  id         String   @id @default(uuid())
  entityType String // "AppConfig", "ContentNode", "RegistryItem", etc.
  entityId   String // The ID of the modified entity
  data       Json // Full snapshot of the record at the time of save
  author     String   @default("Admin")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model SubEvent {
  id           String           @id @default(uuid())
  title        String
  description  String?          @default("")
  startTime    DateTime?
  endTime      DateTime?
  locationName String?          @default("")
  location     String?          @default("")
  category     String?          @default("")
  isPrivate    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  accesses     SubEventAccess[]
  rsvps        SubEventRsvp[]
}

model SubEventAccess {
  id               String         @id @default(uuid())
  subEventId       String
  subEvent         SubEvent       @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  invitationCodeId String
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([subEventId, invitationCodeId])
}

model SubEventRsvp {
  id               String         @id @default(uuid())
  subEventId       String
  subEvent         SubEvent       @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  invitationCodeId String
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Cascade)
  status           String         @default("pending")
  plusOneCount     Int            @default(0)
  dietaryNotes     String?        @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([subEventId, invitationCodeId])
}

model BroadcastMessage {
  id              String               @id @default(uuid())
  channel         String               // "EMAIL" | "SMS"
  subject         String?
  body            String
  targetFilters   Json?
  status          String               @default("PENDING") // "PENDING", "SCHEDULED", "SENDING", "SENT", "FAILED", "PARTIALLY_SENT", "CANCELLED"
  totalRecipients Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  scheduledFor    DateTime?
  sentAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  recipients      BroadcastRecipient[]
}

model BroadcastRecipient {
  id               String           @id @default(uuid())
  broadcastId      String
  broadcast        BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  invitationCodeId String?
  invitationCode   InvitationCode?  @relation(fields: [invitationCodeId], references: [id], onDelete: SetNull)
  guestName        String
  destination      String           // Email or Phone
  status           String           @default("PENDING") // "PENDING", "SENT", "FAILED"
  error            String?
  sentAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

