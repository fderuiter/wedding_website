// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client" // Add recommended output path
}

datasource db {
  provider = "postgresql"
}

model AppConfig {
  id               String   @id @default("global")
  subdomain        String?  @unique
  partner1Name     String   @default("")
  partner2Name     String   @default("")
  brideName        String?  @default("")
  groomName        String?  @default("")
  weddingDate      DateTime @default(dbgenerated("NOW()"))
  baseUrl          String   @default("")
  venueName        String   @default("")
  venueAddress     String   @default("")
  venueCity        String   @default("")
  venueState       String   @default("")
  venueZip         String   @default("")
  latitude         Float    @default(0.0)
  longitude        Float    @default(0.0)
  storyText        String   @default("")
  venueDescription String   @default("")
  travelAdvice     String   @default("")
  heroTitle        String   @default("")
  heroSubtitle     String   @default("")
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  faviconUrl       String   @default("/assets/favicon.png")
  ogImageUrl       String   @default("/images/sunset-embrace.jpg")
  seoKeywords      String   @default("{{partner1Name}} and {{partner2Name}}'s wedding, wedding website, {{venueName}} wedding, {{venueCity}} {{venueState}} wedding, {{partner1Name}} and {{partner2Name}} registry, wedding details, wedding ceremony, wedding reception")
  colorPrimary     String   @default("#B91C1C")
  colorSecondary   String   @default("#B45309")
  themePreset      String   @default("classic")
  features         Json     @default("[]")
  timezone         String   @default("America/Chicago")
  showCountdown    Boolean  @default(true)
  showAddToCalendar Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Media {
  id           String   @id @default(uuid())
  url          String
  altText      String?
  isDecorative Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weddingPartyMembers WeddingPartyMember[]
  attractions         Attraction[]
  registryItems       RegistryItem[]
}

model WeddingPartyMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String
  photoId   String?
  photo     Media?   @relation(fields: [photoId], references: [id])
  link      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attraction {
  id          String   @id @default(uuid())
  name        String
  description String
  imageId     String?
  image       Media?   @relation(fields: [imageId], references: [id])
  category    String
  website     String
  directions  String
  latitude    Float
  longitude   Float
  isVisible   Boolean  @default(true)
  promoCode   String?
  bookingUrl  String?
  roomRate    String?
  cutoffDate  String?
  shuttleInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RegistryItem {
  id                String        @id @default(uuid())
  name              String
  description       String
  category          String
  price             Float
  imageId           String
  image             Media         @relation(fields: [imageId], references: [id])
  vendorUrl         String?
  quantity          Int
  isGroupGift       Boolean       @default(false)
  purchased         Boolean       @default(false)
  purchaserName     String?
  amountContributed Float         @default(0)
  contributors      Contributor[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Contributor {
  id             String        @id @default(uuid())
  name           String
  email          String?
  isPlusOne      Boolean       @default(false)
  amount         Float         @default(0)
  date           DateTime      @default(now())
  registryItem   RegistryItem? @relation(fields: [registryItemId], references: [id], onDelete: Cascade)
  registryItemId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invitationCodeId String?
  invitationCode   InvitationCode? @relation(fields: [invitationCodeId], references: [id])
}

model InvitationCode {
  id                 String        @id @default(uuid())
  code               String        @unique
  guestName          String
  email              String?
  dietaryNotes       String?
  plusOneAllocations Int?          @default(0)
  extraFields        Json?
  used               Boolean       @default(false)
  usedAt             DateTime?
  tableId            String?
  table              SeatingTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  seatNumber         Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  contributors Contributor[]
}

model SeatingTable {
  id              String           @id @default(uuid())
  name            String
  shape           String           @default("round")
  capacity        Int              @default(8)
  x               Float            @default(0.0)
  y               Float            @default(0.0)
  width           Float            @default(120.0)
  height          Float            @default(120.0)
  rotation        Float            @default(0.0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invitationCodes InvitationCode[]
}

model ContentNode {
  id        String   @id @default(uuid())
  type      String // e.g., "FAQ", "Logistics", "Photo"
  tags      String[] // e.g., ["Homepage", "FAQ"]
  data      Json // Flexible key-value pairs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SnapshotVersion {
  id         String   @id @default(uuid())
  entityType String // "AppConfig", "ContentNode", "RegistryItem", etc.
  entityId   String // The ID of the modified entity
  data       Json // Full snapshot of the record at the time of save
  author     String   @default("Admin")
  createdAt  DateTime @default(now())
}
