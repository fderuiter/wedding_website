# ==============================================================================
# Environment Configuration Example
# ==============================================================================
# Note: Do not place actual plain text secrets or passwords in this file.

# NODE_ENV
# Description: Defines the environment the application is running in.
# Allowed Values: development, test, production
# Default: development
NODE_ENV=development

# DATABASE_URL
# Description: Connection string for the primary PostgreSQL database.
# Format: postgresql://[user]:[password]@[host]:[port]/[db]?schema=[schema]
# REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# POSTGRES_URL_NON_POOLING
# Description: Connection string for the shadow database used by Prisma for migrations.
# This should connect directly to the database without a connection pooler.
# OPTIONAL
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/mydb_shadow?schema=public"

# ADMIN_PASSWORD
# Description: Cryptographic hash of the administrative password.
# REQUIRED
# Note: Sensitive! Do not use plain text passwords.
# Format: scrypt:[saltBase64]:[keyBase64]
# Instructions: You must generate an scrypt hash of your password.
# Use a standard scrypt generator to generate this value.
ADMIN_PASSWORD="scrypt:c2FsdA==:aGFzaA=="

# HISTORY_VERSION_LIMIT
# Description: System limit for the number of history versions to keep for content entries.
# Default: 50
HISTORY_VERSION_LIMIT=50

# ==============================================================================
# S3/R2 Hybrid Storage Configuration
# ==============================================================================
# Note: All four credential variables must be specified together if using S3/R2.
# If omitted, the application falls back to zero-config local filesystem storage.

# S3_BUCKET
# Description: The name of the S3/R2 bucket to store uploaded assets.
# OPTIONAL (Mandatory if other S3 variables are specified)
S3_BUCKET="my-wedding-bucket"

# S3_REGION
# Description: The region of the S3 bucket (e.g., 'us-east-1' or 'auto' for R2).
# OPTIONAL (Mandatory if other S3 variables are specified)
S3_REGION="auto"

# S3_ACCESS_KEY_ID
# Description: S3/R2 API access key ID.
# OPTIONAL (Mandatory if other S3 variables are specified)
S3_ACCESS_KEY_ID="your-s3-access-key-id"

# S3_SECRET_ACCESS_KEY
# Description: S3/R2 API secret access key.
# OPTIONAL (Mandatory if other S3 variables are specified)
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# S3_ENDPOINT
# Description: S3-compatible custom endpoint URL (required for Cloudflare R2).
# OPTIONAL
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# S3_PUBLIC_URL
# Description: Public URL prefix / CDN endpoint used to serve assets (e.g. custom domain or public bucket URL).
# OPTIONAL
S3_PUBLIC_URL="https://assets.mywedding.com"

