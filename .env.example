# ==============================================================================
# Environment Configuration Example
# ==============================================================================
# Note: Do not place actual plain text secrets or passwords in this file.

# NODE_ENV
# Description: Defines the environment the application is running in.
# Leave commented out locally so host processes default to 'development' in src/env.ts while Next.js builds use 'production'.
# Allowed Values: development, test, production
# Default: development
# NODE_ENV=development

# DATABASE_URL
# Description: Connection string for the primary PostgreSQL database on the host.
# Format: postgresql://[user]:[password]@[host]:[port]/[db]?schema=[schema]
# REQUIRED (Defaults below match local `docker compose up -d db` / `docker-compose.ci.yml` credentials)
DATABASE_URL="postgresql://wedding:wedding123@localhost:5432/wedding?schema=public"

# DB_PASSWORD
# Description: Password for the Docker Compose PostgreSQL `db` container (`${DB_PASSWORD:?...}`).
# REQUIRED for Docker Compose (`docker compose up -d db` and full-stack container deployments)
DB_PASSWORD="wedding123"

# POSTGRES_URL_NON_POOLING
# Description: Direct non-pooling PostgreSQL connection string on the host used by Prisma migrations in prisma.config.ts (promotes direct connections when DATABASE_URL uses PgBouncer for the same database/schema, or binds a distinct shadow database during `prisma migrate dev`).
# Leave commented out for standard local PostgreSQL so Prisma automatically manages its temporary shadow database (`docker-compose.yml` isolates containers via CONTAINER_POSTGRES_URL_NON_POOLING so host `@localhost:5432` URLs never leak into containers).
# OPTIONAL
# POSTGRES_URL_NON_POOLING="postgresql://wedding:wedding123@localhost:5432/wedding_shadow?schema=public"

# ADMIN_PASSWORD
# Description: Cryptographic hash of the administrative password (16-byte salt + 64-byte scrypt derived key).
# REQUIRED
# Note: Sensitive! Do not use plain text passwords. The dummy placeholder below cannot be used to log in and is rejected in production.
# Format: scrypt:[saltBase64]:[keyBase64]
# Instructions: Generate a valid 64-byte scrypt hash (N=16384, r=8, p=1) matching src/utils/password.ts by running:
#   node scripts/generate-password-hash.mjs "your_password"
ADMIN_PASSWORD="scrypt:AAAAAAAAAAAAAAAAAAAAAA==:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="

# ALLOWED_HOSTS
# Description: Comma-separated list of trusted host domains allowed to access the application.
# Default: localhost,127.0.0.1,*.localhost (Add your public domain(s) in production so external requests are permitted)
ALLOWED_HOSTS="localhost,127.0.0.1,*.localhost,wedding.example,*.wedding.example"

# MULTISITE_ENABLED
# Description: Enable subdomain-based AppConfig branding/profile routing (switches AppConfig rows only; prisma/schema.prisma shares the other 15 tables across subdomains without tenant row isolation).
# Default: false
MULTISITE_ENABLED=false

# RUN_MIGRATIONS
# Description: Automatically execute database schema migrations on container startup in docker-entrypoint.sh.
# Default: false
RUN_MIGRATIONS=false

# TRUST_PROXY
# Description: Trust X-Forwarded-For and X-Real-IP client IP headers from a configured reverse proxy (false for direct loopback, 1 for single-hop Nginx/Caddy/Vercel/Railway/Render, 2 for two-hop Cloud Run/CDN+LB).
# Default: false
TRUST_PROXY=false

# GUEST_PASSCODE
# Description: Global passcode required for guest access to the website.
# REQUIRED in production (Dev/test fallback 'wedding2026' is rejected when NODE_ENV=production)
GUEST_PASSCODE="your-unique-guest-passcode"

# GUEST_SESSION_SECRET
# Description: Dedicated server secret for signing and verifying guest invitation session tokens (HMAC-SHA256).
# REQUIRED in production (Dev/test fallback 'default-guest-session-secret' is rejected in production; must be >=32 chars and distinct from GUEST_PASSCODE)
GUEST_SESSION_SECRET="your-dedicated-guest-session-secret"

# HISTORY_VERSION_LIMIT
# Description: System limit for the number of history versions to keep for content entries.
# Default: 50
HISTORY_VERSION_LIMIT=50

# CRON_SECRET
# Description: Secret authorization key for triggering scheduled cron jobs (e.g. /api/cron/broadcasts).
# OPTIONAL (Recommended in production)
# CRON_SECRET="your-cron-secret-key"

# ==============================================================================
# S3/R2 Hybrid Storage Configuration
# ==============================================================================
# Note: All four credential variables must be specified together if using S3/R2.
# Leave commented out for local development so src/utils/storage.ts uses LocalStorageProvider.

# S3_BUCKET
# Description: The name of the S3/R2 bucket to store uploaded assets.
# OPTIONAL (Mandatory if other S3 variables are specified)
# S3_BUCKET="my-wedding-bucket"

# S3_REGION
# Description: The region of the S3 bucket (e.g., 'us-east-1' or 'auto' for R2).
# OPTIONAL (Mandatory if other S3 variables are specified)
# S3_REGION="auto"

# S3_ACCESS_KEY_ID
# Description: S3/R2 API access key ID.
# OPTIONAL (Mandatory if other S3 variables are specified)
# S3_ACCESS_KEY_ID="your-s3-access-key-id"

# S3_SECRET_ACCESS_KEY
# Description: S3/R2 API secret access key.
# OPTIONAL (Mandatory if other S3 variables are specified)
# S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# S3_ENDPOINT
# Description: S3-compatible custom endpoint URL (required for Cloudflare R2).
# OPTIONAL
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# S3_PUBLIC_URL
# Description: Public URL prefix / CDN endpoint used to serve assets (e.g. custom domain or public bucket URL).
# OPTIONAL
# S3_PUBLIC_URL="https://assets.mywedding.com"

# ==============================================================================
# Optional Stripe Card Checkout Configuration
# ==============================================================================
# Note: STRIPE_SECRET_KEY and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY must be provided
# together to enable online card checkout on registry funds, or both left unset
# when using peer-to-peer direct transfer handles only.

# STRIPE_SECRET_KEY
# Description: Server-side Stripe secret key (starts with sk_ or rk_).
# OPTIONAL (Mandatory if NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is set)
# STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# Description: Client-side Stripe publishable key for Stripe Elements (starts with pk_).
# OPTIONAL (Mandatory if STRIPE_SECRET_KEY is set)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"

# STRIPE_WEBHOOK_SECRET
# Description: Stripe webhook signing secret for /api/registry/webhook/stripe (starts with whsec_).
# OPTIONAL
# STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ==============================================================================
# Optional Docker Compose & Container Runtime Overrides
# ==============================================================================
# Note: `docker-compose.yml` and `docker-compose.rollout.yml` construct container `DATABASE_URL`
# via `${CONTAINER_DATABASE_URL:-...}`, scope container `POSTGRES_URL_NON_POOLING` via
# `${CONTAINER_POSTGRES_URL_NON_POOLING:-}`, and pin container `NODE_ENV` to `production` so host
# `DATABASE_URL`, host `POSTGRES_URL_NON_POOLING` (`@localhost:5432`), and host `NODE_ENV` never
# leak into containers. Set `CONTAINER_DATABASE_URL` (and optional `CONTAINER_POSTGRES_URL_NON_POOLING`
# when `CONTAINER_DATABASE_URL` uses PgBouncer) only when connecting `migration`, `app`, and
# `app-standby` containers to an external PostgreSQL server instead of the bundled `db` service.

# DB_USER
# Description: PostgreSQL username for the Docker Compose `db` container.
# Default: wedding
# DB_USER="wedding"

# DB_NAME
# Description: PostgreSQL database name for the Docker Compose `db` container.
# Default: wedding
# DB_NAME="wedding"

# DB_PORT
# Description: Loopback host TCP port published to container port 5432 (`127.0.0.1:${DB_PORT:-5432}:5432`).
# Default: 5432
# DB_PORT=5432

# CONTAINER_DATABASE_URL
# Description: Explicit PostgreSQL connection URL override for `migration`, `app`, and `app-standby` services in Docker Compose (e.g., external managed PostgreSQL).
# OPTIONAL (Defaults to bundled `@db:5432` service using DB_USER, DB_PASSWORD, and DB_NAME when unset)
# CONTAINER_DATABASE_URL="postgresql://wedding:wedding123@db:5432/wedding?schema=public"

# CONTAINER_POSTGRES_URL_NON_POOLING
# Description: Optional direct non-pooling PostgreSQL connection URL override for `migration`, `app`, and `app-standby` services in Docker Compose when `CONTAINER_DATABASE_URL` routes through PgBouncer (`prisma.config.ts`).
# OPTIONAL (Defaults to empty inside containers so host `POSTGRES_URL_NON_POOLING` never leaks into Compose services)
# CONTAINER_POSTGRES_URL_NON_POOLING="postgresql://wedding:wedding123@db:5432/wedding?schema=public"

# PORT
# Description: HTTP port bound by the standalone server and published on `127.0.0.1:${PORT:-3000}:3000` in Docker Compose.
# Default: 3000
# PORT=3000

# STANDBY_PORT
# Description: Loopback host TCP port published for `app-standby` (`127.0.0.1:${STANDBY_PORT:-3001}:3000`) during zero-downtime VPS rollouts (`scripts/rollout-vps.sh`).
# Default: 3001
# STANDBY_PORT=3001

# HOSTNAME
# Description: Network interface bound by standalone `server.js` inside OCI containers.
# Default: 0.0.0.0
# HOSTNAME="0.0.0.0"

# E2E_TEST
# Description: Automated E2E test mode flag (`false` in production so `<SetupWizard />` onboarding runs).
# Default: false
# E2E_TEST=false

# ==============================================================================
# Optional Layer 1 Site Configuration Overrides (SITE_*)
# ==============================================================================
# Note: All 32 SITE_* variables are optional Layer 1 overrides parsed by
# src/lib/config.ts (getEnvConfigOverrides) and forwarded into `app` and
# `app-standby` by docker-compose.yml and docker-compose.rollout.yml.
# Surrounding whitespace is trimmed automatically, and empty or whitespace-only
# strings are treated as unset so database AppConfig values remain active.

# Partner & Legacy Couple Display Names
# SITE_PARTNER1_NAME="Alex"
# SITE_PARTNER2_NAME="Jordan"
# SITE_BRIDE_NAME="Alex"
# SITE_GROOM_NAME="Jordan"

# Celebration Schedule & Canonical URL
# SITE_WEDDING_DATE="2027-09-18T17:00:00.000Z"
# SITE_BASE_URL="https://wedding.mydomain.com"
# SITE_TIMEZONE="America/Chicago"

# Primary Venue & Coordinates
# SITE_VENUE_NAME="Grand Conservatory"
# SITE_VENUE_ADDRESS="100 Garden Way"
# SITE_VENUE_CITY="Minneapolis"
# SITE_VENUE_STATE="MN"
# SITE_VENUE_ZIP="55401"
# SITE_LATITUDE="44.9778"
# SITE_LONGITUDE="-93.2650"

# Theme, Colors & Homepage Widgets
# SITE_COLOR_PRIMARY="#4A5D4E"
# SITE_COLOR_SECONDARY="#D4AF37"
# SITE_THEME_PRESET="classic"
# SITE_THEME_TOKENS='{"--btn-radius":"12px"}'
# SITE_SHOW_COUNTDOWN="true"
# SITE_SHOW_ADD_TO_CALENDAR="true"

# SEO Metadata & Host Contact
# SITE_SEO_TITLE="Alex & Jordan Wedding"
# SITE_SEO_DESCRIPTION="Join us to celebrate our wedding weekend."
# SITE_CONTACT_EMAIL="couple@wedding.example"

# Branding Assets & Accessible Alt Text
# SITE_BRAND_MONOGRAM="A&J"
# SITE_BRAND_LOGO_URL="/assets/logo.svg"
# SITE_BRAND_LOGO_ALT="Alex and Jordan monogram logo"
# SITE_HERO_IMAGE_URL="/assets/hero.jpg"
# SITE_HERO_IMAGE_ALT="Alex and Jordan standing in the conservatory garden"
# SITE_BRAND_WATERMARK_URL="/assets/watermark.svg"
# SITE_BRAND_WATERMARK_ALT="Floral crest watermark"
# SITE_BADGE_GRAPHIC_URL="/assets/badge.svg"
# SITE_BADGE_GRAPHIC_ALT="Wedding weekend crest badge"

