# ==============================================================================
# Isolated CI & Automated Container Test Environment (.env.ci)
# ==============================================================================
# Loaded via `docker compose --env-file .env.ci -f docker-compose.yml -f docker-compose.ci.yml`
# so pre-merge `${VAR:?...}` required-secret checks in `docker-compose.yml` pass on clean
# checkouts without `.env` and local `.env` host settings never leak into test containers.
# Do NOT use these values in production (`src/env.ts` blocks E2E fallback secrets unless `E2E_TEST=true`).

NODE_ENV=production
DB_USER="wedding"
DB_PASSWORD="wedding123"
DB_NAME="wedding"
DATABASE_URL="postgresql://wedding:wedding123@db:5432/wedding?schema=public"
ADMIN_PASSWORD="scrypt:d2VkZGluZy1lMmUtc2FsdA==:q++ok9TyDBa8bSKUlVR+j/tjiVTGj95CWT5HK8KkpIHzWRnv2t2hAhDz2PkdPUDsMO+ulGpXGCFQAqDKwK7Lxw=="
ALLOWED_HOSTS="localhost,127.0.0.1,*.localhost,app,db,wedding_website-app-1,0.0.0.0"
GUEST_PASSCODE="playwright-e2e-guest-passcode"
GUEST_SESSION_SECRET="playwright-e2e-session-secret-32-chars-min"
E2E_TEST=true
