{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "jest",
      "@testing-library/jest-dom",
      "jest-axe"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "docs-portal/.vitepress/**/*.ts",
    "docs-portal/.vitepress/**/*.mts",
    ".next/types/**/*.ts",
    "jest.config.mjs",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.setup.js",
    "out",
    ".next/export-stage",
    "storybook-static",
    "coverage",
    "playwright-report",
    "test-results",
    "docs-portal/.vitepress/cache",
    "docs-portal/.vitepress/dist"
  ]
}
