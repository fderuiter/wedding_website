#!/usr/bin/env node

import { spawnSync } from 'child_process';

console.log('Running shared pre-push quality profile (scripts/check-quality.ts --pre-push)...');
const result = spawnSync('npm', ['run', 'check:pre-push'], { stdio: 'inherit', shell: true });

if (result.status !== 0) {
  console.error(
    '\n❌ Pre-push quality profile failed. Fix the reported check above and re-run "npm run check:pre-push" before pushing.'
  );
  process.exit(result.status ?? 1);
}

console.log('✅ All pre-push checks passed.');
