#!/usr/bin/env node

import { spawn, spawnSync } from 'child_process';
import fs from 'fs';
import os from 'os';
import path from 'path';

const ZERO_OID_REGEX = /^0+$/;
const LOCKFILE_PATHS = ['package-lock.json', 'docker/prisma-cli/package-lock.json'];
const LOCAL_GIT_ENV_VARS = [
  'GIT_DIR',
  'GIT_WORK_TREE',
  'GIT_INDEX_FILE',
  'GIT_COMMON_DIR',
  'GIT_PREFIX',
];

// Aligned with shared pre-push profile: npm run check:pre-push (scripts/check-quality.ts --pre-push)
const checks = [
  { name: 'TypeScript type check', script: 'type-check' },
  { name: 'ESLint code linting', script: 'lint' },
  { name: 'Knip dead-code analysis', script: 'lint:unused' },
  { name: 'Environment variables documentation check', script: 'check:env-docs' },
  { name: 'Deployment runbooks verification check', script: 'check:runbooks' },
  { name: 'Setup and contributor guides contract check', script: 'check:setup-guides' },
  { name: 'Personal/Template identifier isolation check', script: 'check:identifiers' },
  { name: 'Third-party action pin commit SHAs check', script: 'check:action-pins' },
  {
    name: 'Standalone and container portability static check',
    script: 'check:standalone',
    args: ['--', '--static-only'],
  },
  { name: 'Documentation relative links check', script: 'check:links' },
  { name: 'Specification route and symbol contracts check', script: 'check:spec-contracts' },
  { name: 'Prisma schema validation', script: 'check:prisma' },
  { name: 'Migration compatibility check', script: 'lint:migrations' },
  { name: 'Documentation synchronization check', script: 'check:doc-sync' },
];

const lockfileAuditCheck = { name: 'Security dependency audit', script: 'check:audit' };

function runGit(args, cwd) {
  return spawnSync('git', args, {
    cwd,
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  });
}

function resolveCommitSha(cwd, rev) {
  const res = runGit(['rev-parse', '--verify', '--quiet', `${rev}^{commit}`], cwd);
  return res.status === 0 ? res.stdout.trim() : null;
}

function parsePrePushStdin(repoRoot) {
  if (process.stdin.isTTY) {
    const headSha = resolveCommitSha(repoRoot, 'HEAD');
    if (!headSha) {
      return [];
    }
    return [
      {
        localRef: 'HEAD',
        localSha: headSha,
        remoteRef: 'HEAD',
        remoteSha: '0'.repeat(40),
      },
    ];
  }

  let rawStdin = '';
  try {
    rawStdin = fs.readFileSync(0, 'utf8');
  } catch {
    return [];
  }

  const updates = [];
  for (const rawLine of rawStdin.split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line) {
      continue;
    }
    const parts = line.split(/\s+/);
    if (parts.length < 4) {
      continue;
    }
    const [localRef, localSha, remoteRef, remoteSha] = parts;
    if (localRef === '(delete)' || ZERO_OID_REGEX.test(localSha) || localSha === remoteSha) {
      continue;
    }
    updates.push({ localRef, localSha, remoteRef, remoteSha });
  }
  return updates;
}

function trackedFilesMatchCommit(repoRoot, commitSha) {
  const statusRes = runGit(['status', '--porcelain', '--untracked-files=no'], repoRoot);
  if (statusRes.status !== 0 || statusRes.stdout.trim() !== '') {
    return false;
  }
  const workingDiff = runGit(['diff', '--quiet', commitSha, '--'], repoRoot);
  if (workingDiff.status !== 0) {
    return false;
  }
  const stagedDiff = runGit(['diff', '--cached', '--quiet', commitSha, '--'], repoRoot);
  return stagedDiff.status === 0;
}

function hasRefsUnder(repoRoot, prefix) {
  const res = runGit(['for-each-ref', '--count=1', '--format=%(refname)', prefix], repoRoot);
  return res.status === 0 && res.stdout.trim().length > 0;
}

function isAncestor(repoRoot, ancestorSha, descendantSha) {
  return runGit(['merge-base', '--is-ancestor', ancestorSha, descendantSha], repoRoot).status === 0;
}

function pushedCommitsTouchLockfiles(repoRoot, remoteName, commitSha, remoteShas) {
  for (const remoteSha of remoteShas) {
    if (!ZERO_OID_REGEX.test(remoteSha) && resolveCommitSha(repoRoot, remoteSha)) {
      const diffRes = runGit(
        ['diff', '--name-only', remoteSha, commitSha, '--', ...LOCKFILE_PATHS],
        repoRoot
      );
      if (diffRes.status === 0 && diffRes.stdout.trim() !== '') {
        return true;
      }
      if (isAncestor(repoRoot, remoteSha, commitSha)) {
        const logRes = runGit(
          ['log', '--format=', '--name-only', `${remoteSha}..${commitSha}`, '--', ...LOCKFILE_PATHS],
          repoRoot
        );
        if (logRes.status === 0 && logRes.stdout.trim() !== '') {
          return true;
        }
      }
      continue;
    }

    if (remoteName && hasRefsUnder(repoRoot, `refs/remotes/${remoteName}`)) {
      const remoteLogRes = runGit(
        [
          'log',
          '--format=',
          '--name-only',
          commitSha,
          '--not',
          `--remotes=${remoteName}`,
          '--',
          ...LOCKFILE_PATHS,
        ],
        repoRoot
      );
      if (remoteLogRes.status === 0 && remoteLogRes.stdout.trim() !== '') {
        return true;
      }
      continue;
    }

    if (hasRefsUnder(repoRoot, 'refs/remotes')) {
      const anyRemoteLogRes = runGit(
        ['log', '--format=', '--name-only', commitSha, '--not', '--remotes', '--', ...LOCKFILE_PATHS],
        repoRoot
      );
      if (anyRemoteLogRes.status === 0 && anyRemoteLogRes.stdout.trim() !== '') {
        return true;
      }
      continue;
    }

    const parentSha = resolveCommitSha(repoRoot, `${commitSha}^`);
    if (parentSha) {
      const parentDiffRes = runGit(
        ['diff', '--name-only', parentSha, commitSha, '--', ...LOCKFILE_PATHS],
        repoRoot
      );
      if (parentDiffRes.status === 0 && parentDiffRes.stdout.trim() !== '') {
        return true;
      }
    } else {
      const rootShowRes = runGit(
        ['show', '--format=', '--name-only', commitSha, '--', ...LOCKFILE_PATHS],
        repoRoot
      );
      if (rootShowRes.status === 0 && rootShowRes.stdout.trim() !== '') {
        return true;
      }
    }
  }

  return false;
}

function rewriteEslintCacheForWorktree(srcCache, destCache, repoRoot, worktreeDir) {
  const raw = fs.readFileSync(srcCache, 'utf8');
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    fs.copyFileSync(srcCache, destCache);
    return;
  }

  if (!Array.isArray(parsed)) {
    fs.copyFileSync(srcCache, destCache);
    return;
  }

  const realRepoRoot = fs.realpathSync(repoRoot);
  const resolvedRepoRoot = path.resolve(repoRoot);
  const realWorktreeDir = fs.realpathSync(worktreeDir);
  const sourceRoots = Array.from(new Set([realRepoRoot, resolvedRepoRoot]));
  const rewrittenByIndex = new Map();

  for (let i = 0; i < parsed.length; i++) {
    const value = parsed[i];
    if (typeof value !== 'string') {
      continue;
    }

    for (const rootCandidate of sourceRoots) {
      const prefix = `${rootCandidate}${path.sep}`;
      if (value.startsWith(prefix)) {
        const relPath = value.slice(prefix.length);
        const srcFile = path.join(realRepoRoot, relPath);
        const destFile = path.join(realWorktreeDir, relPath);
        parsed[i] = destFile;
        rewrittenByIndex.set(i, { srcFile, destFile });
        break;
      }
    }
  }

  for (const entry of parsed) {
    if (
      !entry ||
      typeof entry !== 'object' ||
      Array.isArray(entry) ||
      typeof entry.key !== 'string' ||
      typeof entry.value !== 'string'
    ) {
      continue;
    }

    const keyIndex = Number.parseInt(entry.key, 10);
    const valueIndex = Number.parseInt(entry.value, 10);
    const fileMapping = rewrittenByIndex.get(keyIndex);
    const meta = parsed[valueIndex];
    if (
      !fileMapping ||
      !meta ||
      typeof meta !== 'object' ||
      Array.isArray(meta) ||
      typeof meta.size !== 'number' ||
      typeof meta.mtime !== 'number'
    ) {
      continue;
    }

    let cacheReusable = false;
    try {
      const srcStat = fs.statSync(fileMapping.srcFile);
      const destStat = fs.statSync(fileMapping.destFile);
      if (
        srcStat.isFile() &&
        destStat.isFile() &&
        srcStat.size === meta.size &&
        destStat.size === meta.size &&
        srcStat.mtime.getTime() === meta.mtime &&
        fs.readFileSync(fileMapping.srcFile).equals(fs.readFileSync(fileMapping.destFile))
      ) {
        meta.mtime = destStat.mtime.getTime();
        cacheReusable = true;
      }
    } catch {
      cacheReusable = false;
    }

    if (!cacheReusable) {
      meta.mtime = -1;
      delete meta.hash;
    }
  }

  fs.writeFileSync(destCache, JSON.stringify(parsed), 'utf8');
}

function hydrateWorktreeCaches(repoRoot, worktreeDir) {
  const srcNodeModules = path.join(repoRoot, 'node_modules');
  const destNodeModules = path.join(worktreeDir, 'node_modules');
  if (fs.existsSync(srcNodeModules) && !fs.existsSync(destNodeModules)) {
    fs.symlinkSync(
      srcNodeModules,
      destNodeModules,
      process.platform === 'win32' ? 'junction' : 'dir'
    );
  }

  const srcNextEnv = path.join(repoRoot, 'next-env.d.ts');
  const destNextEnv = path.join(worktreeDir, 'next-env.d.ts');
  try {
    if (fs.existsSync(srcNextEnv) && !fs.existsSync(destNextEnv) && fs.statSync(srcNextEnv).isFile()) {
      fs.copyFileSync(srcNextEnv, destNextEnv);
    }
  } catch {
    // Ignore concurrent next-env.d.ts updates during copy
  }

  const srcNextTypes = path.join(repoRoot, '.next', 'types');
  const destNextTypes = path.join(worktreeDir, '.next', 'types');
  try {
    if (fs.existsSync(srcNextTypes) && !fs.existsSync(destNextTypes) && fs.statSync(srcNextTypes).isDirectory()) {
      fs.mkdirSync(path.dirname(destNextTypes), { recursive: true });
      fs.cpSync(srcNextTypes, destNextTypes, { recursive: true });
    }
  } catch {
    // Ignore concurrent .next/types updates during copy
  }

  for (const entry of fs.readdirSync(repoRoot)) {
    if (entry !== '.eslintcache' && !entry.endsWith('.tsbuildinfo')) {
      continue;
    }
    const srcCache = path.join(repoRoot, entry);
    const destCache = path.join(worktreeDir, entry);
    try {
      if (!fs.statSync(srcCache).isFile()) {
        continue;
      }
      if (entry === '.eslintcache') {
        rewriteEslintCacheForWorktree(srcCache, destCache, repoRoot, worktreeDir);
      } else {
        fs.copyFileSync(srcCache, destCache);
      }
    } catch {
      // Ignore concurrent cache rotation during copy
    }
  }
}

function buildIsolatedWorktreeEnv() {
  const childEnv = { ...process.env };
  for (const key of LOCAL_GIT_ENV_VARS) {
    delete childEnv[key];
  }
  return childEnv;
}

function terminateCheckProcess(child) {
  if (child.pid && process.platform !== 'win32') {
    try {
      process.kill(-child.pid, 'SIGTERM');
      return;
    } catch {
      // Fall back to direct child termination
    }
  }
  try {
    child.kill('SIGTERM');
  } catch {
    // Ignore already-exited child processes
  }
}

function resolvePrePushConcurrency(childEnv, totalChecks) {
  const envConcurrency = Number.parseInt(childEnv.PRE_PUSH_CONCURRENCY ?? '', 10);
  const defaultWorkers = Math.max(
    2,
    Math.min(6, typeof os.availableParallelism === 'function' ? os.availableParallelism() : os.cpus().length)
  );
  const requested = Number.isFinite(envConcurrency) && envConcurrency > 0 ? envConcurrency : defaultWorkers;
  return Math.max(1, Math.min(totalChecks, requested));
}

function runSingleCheck(check, targetDir, childEnv, activeChildren, isCancelled) {
  return new Promise((resolve) => {
    if (isCancelled()) {
      resolve({ status: 0, stdout: '', stderr: '', cancelled: true });
      return;
    }

    const stdoutChunks = [];
    const stderrChunks = [];
    let settled = false;

    const child = spawn('npm', ['run', check.script, ...(check.args ?? [])], {
      cwd: targetDir,
      env: childEnv,
      shell: true,
      detached: process.platform !== 'win32',
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    activeChildren.add(child);

    if (child.stdout) {
      child.stdout.on('data', (chunk) => {
        stdoutChunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
      });
    }
    if (child.stderr) {
      child.stderr.on('data', (chunk) => {
        stderrChunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
      });
    }

    const finish = (status) => {
      if (settled) {
        return;
      }
      settled = true;
      activeChildren.delete(child);
      resolve({
        status: status ?? 1,
        stdout: Buffer.concat(stdoutChunks).toString('utf8'),
        stderr: Buffer.concat(stderrChunks).toString('utf8'),
        cancelled: isCancelled(),
      });
    };

    child.on('error', () => finish(1));
    child.on('close', (code) => finish(code));
  });
}

function flushCheckOutput(stdout, stderr) {
  if (stdout) {
    process.stdout.write(stdout.endsWith('\n') ? stdout : `${stdout}\n`);
  }
  if (stderr) {
    process.stderr.write(stderr.endsWith('\n') ? stderr : `${stderr}\n`);
  }
}

async function executeChecks(targetDir, childEnv, includeLockfileAudit) {
  const baseChecks = includeLockfileAudit
    ? [...checks.slice(0, 3), lockfileAuditCheck, ...checks.slice(3)]
    : checks;
  const docSyncCheck = baseChecks.find((item) => item.script === 'check:doc-sync');
  const orderedChecks = docSyncCheck
    ? [
        ...baseChecks.slice(0, 2),
        docSyncCheck,
        ...baseChecks.slice(2).filter((item) => item.script !== 'check:doc-sync'),
      ]
    : baseChecks;

  const workerCount = resolvePrePushConcurrency(childEnv, orderedChecks.length);
  const activeChildren = new Set();
  let nextCheckIndex = 0;
  let failure = null;

  const workers = Array.from({ length: workerCount }, async () => {
    while (failure === null) {
      const currentIndex = nextCheckIndex++;
      if (currentIndex >= orderedChecks.length) {
        return;
      }

      const check = orderedChecks[currentIndex];
      console.log(`Running ${check.name}...`);
      const result = await runSingleCheck(
        check,
        targetDir,
        childEnv,
        activeChildren,
        () => failure !== null
      );

      if (failure !== null) {
        return;
      }

      if (result.status !== 0) {
        failure = {
          check,
          status: result.status || 1,
          stdout: result.stdout,
          stderr: result.stderr,
        };
        for (const activeChild of Array.from(activeChildren)) {
          terminateCheckProcess(activeChild);
        }
        return;
      }

      flushCheckOutput(result.stdout, result.stderr);
    }
  });

  await Promise.allSettled(workers);

  if (failure !== null) {
    flushCheckOutput(failure.stdout, failure.stderr);
    console.error(`\n❌ Pre-push check failed: ${failure.check.name} failed.`);
    return failure.status;
  }

  return 0;
}

const topLevelRes = runGit(['rev-parse', '--show-toplevel'], process.cwd());
if (topLevelRes.status !== 0 || !topLevelRes.stdout.trim()) {
  console.error('❌ Pre-push check failed: Unable to determine Git repository root.');
  process.exit(1);
}
const repoRoot = topLevelRes.stdout.trim();
const remoteName = process.argv[2] ?? '';

const rawUpdates = parsePrePushStdin(repoRoot);
if (rawUpdates.length === 0) {
  console.log('✅ No new commit refs to verify; skipping pre-push checks.');
  process.exit(0);
}

const commitUpdates = new Map();
for (const update of rawUpdates) {
  const commitSha = resolveCommitSha(repoRoot, update.localSha);
  if (!commitSha) {
    continue;
  }
  if (!commitUpdates.has(commitSha)) {
    commitUpdates.set(commitSha, []);
  }
  commitUpdates.get(commitSha).push(update.remoteSha);
}

if (commitUpdates.size === 0) {
  console.log('✅ No commit refs to verify; skipping pre-push checks.');
  process.exit(0);
}

const activeWorktrees = new Map();

function cleanupWorktree(worktreeDir) {
  const tempBaseDir = activeWorktrees.get(worktreeDir);
  if (!tempBaseDir) {
    return;
  }
  activeWorktrees.delete(worktreeDir);
  runGit(['worktree', 'remove', '--force', worktreeDir], repoRoot);
  try {
    fs.rmSync(tempBaseDir, { recursive: true, force: true });
  } catch {
    // Ignore best-effort directory removal errors
  }
  runGit(['worktree', 'prune'], repoRoot);
}

function cleanupAllWorktrees() {
  for (const worktreeDir of Array.from(activeWorktrees.keys())) {
    cleanupWorktree(worktreeDir);
  }
}

process.on('exit', cleanupAllWorktrees);
for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
  process.on(sig, () => {
    cleanupAllWorktrees();
    process.exit(1);
  });
}

const headSha = resolveCommitSha(repoRoot, 'HEAD');
const uniqueCommitShas = Array.from(commitUpdates.keys());
const canRunInPlace =
  uniqueCommitShas.length === 1 &&
  headSha === uniqueCommitShas[0] &&
  trackedFilesMatchCommit(repoRoot, uniqueCommitShas[0]);

if (canRunInPlace) {
  const commitSha = uniqueCommitShas[0];
  const includeAudit = pushedCommitsTouchLockfiles(
    repoRoot,
    remoteName,
    commitSha,
    commitUpdates.get(commitSha)
  );
  const status = await executeChecks(repoRoot, process.env, includeAudit);
  if (status !== 0) {
    process.exit(status);
  }
} else {
  const worktreeEnv = buildIsolatedWorktreeEnv();
  for (const commitSha of uniqueCommitShas) {
    const includeAudit = pushedCommitsTouchLockfiles(
      repoRoot,
      remoteName,
      commitSha,
      commitUpdates.get(commitSha)
    );
    const tempBaseDir = fs.mkdtempSync(path.join(os.tmpdir(), 'wedding-pre-push-'));
    const worktreeDir = path.join(tempBaseDir, 'worktree');
    activeWorktrees.set(worktreeDir, tempBaseDir);

    let status = 0;
    try {
      console.log(`Verifying pushed commit ${commitSha.slice(0, 12)} in ephemeral Git worktree...`);
      const addRes = runGit(['worktree', 'add', '--detach', worktreeDir, commitSha], repoRoot);
      if (addRes.status !== 0) {
        console.error(
          `\n❌ Pre-push check failed: Unable to create ephemeral worktree for ${commitSha}:\n${addRes.stderr || addRes.stdout}`
        );
        status = addRes.status ?? 1;
      } else {
        hydrateWorktreeCaches(repoRoot, worktreeDir);
        status = await executeChecks(worktreeDir, worktreeEnv, includeAudit);
      }
    } finally {
      cleanupWorktree(worktreeDir);
    }

    if (status !== 0) {
      process.exit(status);
    }
  }
}

console.log('✅ All pre-push checks passed.');
