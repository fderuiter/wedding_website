# Production
/build
/storybook-static

# Misc
.DS_Store
*.pem

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local Environment Variables
.env*.local
.env

# Prisma
# Ignore generic SQLite database files (in case of accidental local creation)
*.db
*.db-journal
*.sqlite
# Ignore generated Prisma client
node_modules/@prisma/client

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

# IDEs and configuration files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS file attributes
._*
.vercel

# Jules
.jules/
.Jules/
test-results/

# TypeScript & ESLint caches
tsconfig.tsbuildinfo
*.tsbuildinfo
.eslintcache

# VitePress
docs-portal/.vitepress/dist
docs-portal/.vitepress/cache
docs-portal/.vitepress/.temp
docs-portal/architecture
docs-portal/deployment
docs-portal/development
docs-portal/features
