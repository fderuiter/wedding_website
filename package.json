{
  "name": "wedding_website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --turbo",
    "prebuild": "npx tsx scripts/generate-docs.ts",
    "build": "npm run lint && npm run lint:migrations && npm run lint:unused && prisma generate && next build",
    "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:migrations": "tsx scripts/verify-migration-compatibility.ts",
    "lint:unused": "knip",
    "lint:unused:fix": "knip --fix --allow-remove-files",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/pretest.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:a11y": "rm -rf test-results && npm test; npx playwright test; node scripts/a11y-report.mjs",
    "test:standalone": "node scripts/test-standalone.mjs",
    "test:container": "node scripts/test-container.mjs",
    "migrate:dev": "dotenv -e .env.development.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e .env.development.local -- prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "prisma:generate": "prisma generate",
    "check:action-pins": "npx tsx scripts/check-action-pins.ts",
    "check:identifiers": "npx tsx scripts/check-personal-identifiers.ts",
    "check:links": "npx tsx scripts/check-doc-links.ts",
    "check:prisma": "npx tsx scripts/check-prisma-schema.ts",
    "check:standalone": "npx tsx scripts/check-docker-build.ts",
    "check:env-docs": "npx tsx scripts/verify-env-docs.ts",
    "check:audit": "npm audit --audit-level=high",
    "quality": "npx tsx scripts/check-quality.ts",
    "check:all": "npm run quality",
    "scaffold": "node scripts/scaffold-feature.mjs",
    "prepare": "node -e 'import(\"fs\").then(f => f.existsSync(\"./scripts/install-git-hooks.js\") && import(\"./scripts/install-git-hooks.js\"))'",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/config": "^7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@react-three/rapier": "^2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "archiver": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "framer-motion": "^14.4.0",
    "ics": "^3.12.1",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "node-html-parser": "^9.0.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.27.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.18",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  }
}
