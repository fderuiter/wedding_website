{
  "name": "wedding_website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.1 <23.0.0",
    "npm": "^10.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.1 <23.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^10.9.0",
      "onFail": "error"
    }
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "build:docker": "prisma generate && next build && node src/lib/patch-standalone-server.js",
    "build:export": "node scripts/build-export.mjs",
    "postbuild": "[ -d .next/standalone ] && rm -rf .next/standalone/.next/static .next/standalone/public .next/standalone/src .next/standalone/node_modules/pdfkit/.yarn .next/standalone/node_modules/pdfkit/js/pdfkit.standalone.js .next/standalone/node_modules/pdfkit/js/pdfkit.browser.js .next/standalone/node_modules/pdfkit/js/pdfkit.browser.mjs .next/standalone/node_modules/pdfkit/js/pdfkit.browser.old.js .next/standalone/node_modules/pdfkit/js/pdfkit.browser.old.mjs .next/standalone/node_modules/pdfkit/js/pdfkit.old.js .next/standalone/node_modules/pdfkit/lib/fs/browser.js .next/standalone/node_modules/pdfkit/lib/zlib/browser.js .next/standalone/node_modules/pdfkit/lib/stream/browser.js .next/standalone/node_modules/fontkit/dist/browser.cjs .next/standalone/node_modules/fontkit/dist/browser-module.mjs .next/standalone/node_modules/fontkit/src && find .next/standalone/node_modules -type d \\( -name test -o -name tests -o -name __tests__ \\) -prune -exec rm -rf {} + && find .next/standalone -type f \\( -name '*.nft.json' -o -name '*.d.ts' -o -name '*.map' -o -path '*/src/*.ts' -o -path '*/src/*.tsx' \\) -delete && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && rm -f .next/standalone/public/mockServiceWorker.js && node src/lib/patch-standalone-server.js || true",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --cache --cache-location .eslintcache --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location .eslintcache --fix --max-warnings 0",
    "lint:migrations": "node --experimental-strip-types scripts/verify-migration-compatibility.ts",
    "lint:unused": "knip",
    "lint:unused:fix": "knip --fix --allow-remove-files",
    "type-check": "next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.scripts.json",
    "pretest": "node scripts/pretest.mjs",
    "pretest:watch": "npm run pretest",
    "pretest:cov": "npm run pretest",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "NODE_OPTIONS=--max-old-space-size=4096 jest --coverage --maxWorkers=1",
    "test:cov:html": "COVERAGE_HTML=true npm run test:cov",
    "test:a11y": "node scripts/a11y-report.mjs --run",
    "test:a11y:unit": "node scripts/a11y-report.mjs --unit",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:standalone": "node scripts/test-standalone.mjs",
    "test:container": "node scripts/test-container.mjs",
    "migrate:dev": "dotenv -c development -- prisma migrate dev",
    "migrate:deploy": "dotenv -c development -- prisma migrate deploy",
    "migrate:status": "dotenv -c development -- tsx scripts/preflight-migration-summary.ts --require-db",
    "preflight:env": "tsx scripts/preflight-env.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:seed": "dotenv -c development -- tsx scripts/seed.ts",
    "prisma:generate": "prisma generate",
    "check:action-pins": "npx tsx scripts/check-action-pins.ts",
    "check:identifiers": "npx tsx scripts/check-personal-identifiers.ts",
    "check:links": "npx tsx scripts/check-doc-links.ts",
    "check:prisma": "tsx scripts/check-prisma-schema.ts",
    "check:standalone": "npx tsx scripts/check-docker-build.ts",
    "check:env-docs": "npx tsx scripts/verify-env-docs.ts",
    "check:runbooks": "npx tsx scripts/verify-deployment-runbooks.ts",
    "check:doc-sync": "npx tsx scripts/verify-doc-sync.ts",
    "check:setup-guides": "npx tsx scripts/verify-setup-guides.ts",
    "check:spec-contracts": "npx tsx scripts/verify-spec-contracts.ts",
    "check:static": "npx tsx scripts/check-quality.ts --static",
    "check:quality": "npx tsx scripts/check-quality.ts",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "docs:dev": "npx tsx scripts/generate-portal.ts --watch --serve",
    "docs:build": "npx tsx scripts/generate-portal.ts && vitepress build docs-portal",
    "docs:preview": "vitepress preview docs-portal",
    "pages:build": "node scripts/build-pages-bundle.mjs",
    "pages:verify": "TEST_CONTAINER=true playwright test e2e/pages-showcase.spec.ts",
    "quality": "npx tsx scripts/check-quality.ts",
    "check:all": "npm run quality",
    "scaffold": "node scripts/scaffold-feature.mjs",
    "prepare": "node -e 'import(\"fs\").then(f => f.existsSync(\"./scripts/install-git-hooks.js\") && import(\"./scripts/install-git-hooks.js\"))'",
    "postinstall": "next typegen && prisma generate && node scripts/pretest.mjs --record-install-state"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/config": "^7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@tanstack/react-query": "^5.108.2",
    "archiver": "^8.0.0",
    "dotenv-cli": "^11.1.0",
    "framer-motion": "^14.14.0",
    "heic-decode": "^2.1.0",
    "ics": "^3.12.1",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "node-html-parser": "^9.0.7",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "postprocessing": "^6.39.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "0.35.5",
    "stripe": "^23.2.0",
    "three": "^0.187.0",
    "undici": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@storybook/react": "^10.6.8",
    "@storybook/react-webpack5": "^10.6.8",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/heic-decode": "^2.0.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.12.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "babel-loader": "^10.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.1",
    "mermaid": "^12.3.0",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "postcss-loader": "^8.2.1",
    "prisma": "^7.10.1",
    "storybook": "^10.6.8",
    "swagger-ui-dist": "^5.35.1",
    "tailwindcss": "^4.1.18",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "archiver": {
      "minimatch": "^11.0.8"
    },
    "effect": "^3.22.5",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "image-size": "^2.1.0",
    "msw-storybook-addon": {
      "msw": "$msw"
    },
    "sharp": "$sharp",
    "vite": "^6.4.6",
    "vitepress-plugin-mermaid": {
      "mermaid": "$mermaid"
    },
    "webpack-dev-middleware": "^7.4.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix --max-warnings=0"
  }
}
