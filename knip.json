{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "src/app/**/error.tsx",
    "src/app/**/not-found.tsx",
    "e2e/**/*.spec.ts",
    "e2e/**/*.audit.ts",
    "eslint-rules/**/*.mjs",
    "jest.polyfills.js",
    "jest.setup.js",
    "jest.setup.jsdom.js",
    "jest-serial-runner.cjs",
    "jest-a11y-reporter.cjs",
    "jsdom-env.cjs",
    "src/__tests__/**/*.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}",
    "src/testing/**/*.ts",
    "scripts/**/*.test.ts",
    "src/mocks/handlers.ts",
    "src/mocks/server.ts",
    "scripts/*.ts",
    "scripts/*.mjs",
    "scripts/*.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "e2e/**/*.ts",
    "eslint-rules/**/*.mjs"
  ],
  "github-actions": false,
  "ignoreDependencies": [
    "@electric-sql/pglite",
    "@electric-sql/pglite-socket",
    "lint-staged",
    "mermaid",
    "vitepress-plugin-mermaid",
    "swagger-ui-dist"
  ],
  "rules": {
    "duplicates": "off",
    "files": "error",
    "exports": "error",
    "nsExports": "error",
    "namespaceMembers": "warn",
    "enumMembers": "warn",
    "types": "error",
    "nsTypes": "error"
  },
  "treatConfigHintsAsErrors": false
}
