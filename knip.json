{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "src/app/**/error.tsx",
    "src/app/**/not-found.tsx",
    "e2e/**/*.spec.ts",
    "eslint-rules/**/*.mjs",
    "src/__tests__/**/*.{ts,tsx}",
    "src/features/**/admin.service.ts",
    "src/features/**/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "e2e/**/*.ts",
    "eslint-rules/**/*.mjs"
  ],
  "github-actions": false,
  "ignoreDependencies": ["tailwindcss"],
  "rules": {
    "files": "error",
    "exports": "error",
    "nsExports": "error",
    "namespaceMembers": "warn",
    "enumMembers": "warn",
    "types": "error",
    "nsTypes": "error"
  },
  "treatConfigHintsAsErrors": true
}
