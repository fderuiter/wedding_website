{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "storybook-static",
    "jest.setup.js",
    "scripts",
    "e2e",
    ".storybook",
    "docs-portal",
    "playwright.config.ts",
    "playwright.static.config.ts",
    "prisma.config.ts",
    "src/mocks",
    "src/testing",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/__tests__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
